{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "To-Do application with Google OAuth and AWS hosting",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test": "node node_modules/jest/bin/jest.js",
    "test:frontend": "node node_modules/jest/bin/jest.js frontend",
    "test:backend": "node node_modules/jest/bin/jest.js backend",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node node_modules/jest/bin/jest.js --coverage",
    "start:backend": "node backend/local-server.js"
  },
  "keywords": [
    "todo",
    "oauth",
    "aws"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "supertest": "^6.3.4"
  }
}
