# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================================================

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (REQUIRED)
# ============================================================================
# Get your Google Client ID from: https://console.cloud.google.com/apis/credentials
# 
# Setup Instructions:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Create a new project or select existing project
# 3. Enable Google+ API
# 4. Go to "Credentials" and create "OAuth 2.0 Client ID"
# 5. Add authorized JavaScript origins:
#    - For local: http://localhost:8000
#    - For production: https://yourdomain.com
# 6. Add authorized redirect URIs:
#    - For local: http://localhost:8000
#    - For production: https://yourdomain.com
# 7. Copy the Client ID here
#
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================
# Valid values: local, development, staging, production
# This determines which configuration set is used
ENVIRONMENT=local

# ============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================================================
# Backend API URL for local development
# The local Express server should run on this URL
API_BASE_URL=http://localhost:3000

# Frontend URL for local development
# Used for CORS configuration and OAuth redirects
FRONTEND_URL=http://localhost:8000

# ============================================================================
# AWS CONFIGURATION (FOR DEPLOYMENT ONLY)
# ============================================================================
# AWS Region where resources will be deployed
AWS_REGION=us-east-1

# Your AWS Account ID (12-digit number)
# Find this in AWS Console under "My Account"
AWS_ACCOUNT_ID=123456789012

# ============================================================================
# DYNAMODB CONFIGURATION (FOR AWS DEPLOYMENT)
# ============================================================================
# DynamoDB table name for storing tasks
# Format: TodoTasks-{environment}
# Examples:
#   - TodoTasks-local (for local testing with DynamoDB Local)
#   - TodoTasks-development
#   - TodoTasks-staging
#   - TodoTasks-production
DYNAMODB_TABLE_NAME=TodoTasks-local

# ============================================================================
# CLOUDFORMATION CONFIGURATION (FOR AWS DEPLOYMENT)
# ============================================================================
# CloudFormation stack name
# Format: todo-app-{environment}
STACK_NAME=todo-app-local

# ============================================================================
# CLOUDFRONT CONFIGURATION (FOR AWS DEPLOYMENT)
# ============================================================================
# CloudFront Distribution ID (obtained after first deployment)
# Used for cache invalidation during deployments
# Leave empty for initial deployment
CLOUDFRONT_DISTRIBUTION_ID=

# ============================================================================
# ENVIRONMENT-SPECIFIC GOOGLE CLIENT IDS (OPTIONAL)
# ============================================================================
# You can use different Google Client IDs for different environments
# This is recommended for security and proper OAuth redirect configuration
#
# LOCAL_GOOGLE_CLIENT_ID=your-local-client-id.apps.googleusercontent.com
# DEV_GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
# STAGING_GOOGLE_CLIENT_ID=your-staging-client-id.apps.googleusercontent.com
# PROD_GOOGLE_CLIENT_ID=your-prod-client-id.apps.googleusercontent.com

# ============================================================================
# ENVIRONMENT-SPECIFIC API URLS (OPTIONAL)
# ============================================================================
# Override API URLs for specific environments
# These are automatically set by config.js based on hostname detection
# Only set these if you need to override the automatic detection
#
# DEV_API_BASE_URL=https://api-dev.yourdomain.com
# STAGING_API_BASE_URL=https://api-staging.yourdomain.com
# PROD_API_BASE_URL=https://api.yourdomain.com

# ============================================================================
# NOTES
# ============================================================================
# - For local development, you only need to set GOOGLE_CLIENT_ID
# - The frontend automatically detects environment based on hostname
# - AWS variables are only needed when deploying to AWS
# - Keep separate .env files for different environments (e.g., .env.dev, .env.staging)
# - Use environment variables in CI/CD pipelines instead of .env files
