# Google OAuth Configuration
# Get your Google Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Environment
ENVIRONMENT=local

# DynamoDB Table Name (for AWS deployment)
DYNAMODB_TABLE_NAME=TodoTasks-local

# API Configuration
API_BASE_URL=http://localhost:3000

# Frontend Configuration
FRONTEND_URL=http://localhost:8000

# CloudFormation Stack Name (for AWS deployment)
STACK_NAME=todo-app-local

# CloudFront Distribution ID (for AWS deployment)
CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id-here
