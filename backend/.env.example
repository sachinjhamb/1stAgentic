# ============================================================================
# Backend Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================================================

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (REQUIRED)
# ============================================================================
# Your Google OAuth 2.0 Client ID
# This is used to verify ID tokens sent from the frontend
# 
# Setup Instructions:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Navigate to "APIs & Services" > "Credentials"
# 3. Create or select an OAuth 2.0 Client ID
# 4. Copy the Client ID (format: xxx.apps.googleusercontent.com)
# 5. Paste it below
#
# IMPORTANT: Use the same Client ID as configured in the frontend
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port number for the local development server
# Default: 3000
# Make sure this matches the API_BASE_URL in frontend config
PORT=3000

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================
# Allowed origins for CORS requests
# For local development, this should match your frontend URL
# Multiple origins can be comma-separated
# Default: http://localhost:8000
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Current environment: local, development, staging, production
# Used for logging and debugging
ENVIRONMENT=local

# ============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# ============================================================================
# Log level: error, warn, info, debug
# Default: info
# LOG_LEVEL=info

# ============================================================================
# DYNAMODB CONFIGURATION (FOR AWS LAMBDA DEPLOYMENT)
# ============================================================================
# These variables are only used when deploying Lambda functions to AWS
# Not needed for local development (uses in-memory storage)
#
# DynamoDB table name
# DYNAMODB_TABLE_NAME=TodoTasks-local
#
# AWS Region
# AWS_REGION=us-east-1

# ============================================================================
# INSTRUCTIONS FOR LOCAL DEVELOPMENT
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Set your GOOGLE_CLIENT_ID (required)
# 3. Optionally adjust PORT if 3000 is already in use
# 4. Run the server: node local-server.js
# 5. The server will start on http://localhost:3000
#
# For testing:
# - Make sure the frontend is configured to use http://localhost:3000 as API_BASE_URL
# - Ensure CORS is properly configured to allow requests from your frontend URL

# ============================================================================
# INSTRUCTIONS FOR AWS DEPLOYMENT
# ============================================================================
# For Lambda functions, set these environment variables in AWS Lambda console:
# - GOOGLE_CLIENT_ID: Your Google OAuth Client ID
# - DYNAMODB_TABLE_NAME: Name of your DynamoDB table
# - ENVIRONMENT: deployment environment (development, staging, production)
#
# These can also be set in CloudFormation template or deployment scripts
